{
  "name": "Surf Journal",
  "short_name": "Surf Journal",
  "description": "Log surf sessions against real conditions and get spot recommendations from your own history.",
  "id": "./",
  "start_url": "./#/explore",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f3f6f8",
  "theme_color": "#0b4f6c",
  "categories": ["sports", "lifestyle", "weather"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Log a session", "short_name": "Log", "url": "./#/log", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Journal", "url": "./#/journal", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ]
}
